{
  "name": "exo-gltf-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "glTF/GLB viewer and inspector plugin for the Exo editor",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exo/plugin-sdk": "1.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
